# Copy to .env.local and fill in. Never commit .env.local — it is ignored repo-wide.
#
# Values come from the WorkOS dashboard: https://dashboard.workos.com
# Applications -> your app -> API keys / Redirects.

# --- WorkOS AuthKit -----------------------------------------------------------
# Secret. Server-side only, never exposed to the browser.
WORKOS_API_KEY=sk_test_

# Same client id the backend uses to build its JWKS URL. Both sides must agree,
# or the backend rejects every token this app obtains.
WORKOS_CLIENT_ID=client_

# Seals the session cookie. Minimum 32 characters, and different per environment.
# Generate one with:  openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# Must be registered verbatim as a redirect URI in the WorkOS dashboard, or the
# sign-in round trip fails with a redirect_uri mismatch.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# --- TradeTies backend --------------------------------------------------------
# Where the Spring API lives. Server-side only and deliberately NOT NEXT_PUBLIC_:
# the browser never calls the backend directly. Server components forward the
# caller's access token, which is what keeps the token out of client JavaScript.
API_BASE_URL=http://localhost:8080

# --- Public profiles ----------------------------------------------------------
# Where a published profile is served, as the wizard and the dashboard print it.
# Must match the backend's PROFILE_URL_PREFIX: it composes the same string into
# the message shown when a URL is already locked.
NEXT_PUBLIC_PROFILE_URL_PREFIX=tradeties.com/pro/
