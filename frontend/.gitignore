# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env files — secrets never get committed, the template always does.
# Without the exception this pattern also swallows .env.example, which is the
# one file a new contributor needs (the root .gitignore already allows it).
.env*
!.env.example

# Generated from api/openapi.yaml by `pnpm generate:api`, which runs ahead of
# dev and build. Generated sources are never committed (DECISIONS section 5).
/lib/api/schema.d.ts

# Vercel
.vercel

# Typescript
*.tsbuildinfo
next-env.d.ts
