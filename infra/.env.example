# Copy to .env and fill in. Never commit .env — it is ignored repo-wide.
#
# Only needed to run the stack via Docker Compose. Local backend development
# uses `./mvnw spring-boot:test-run`, which provisions PostgreSQL itself.

# --- PostgreSQL -------------------------------------------------------------
# The defaults in application.yml point at a local database; override them here
# so the backend reaches the Compose-managed one instead.
DATABASE_URL=jdbc:postgresql://postgres:5432/tradeties
DATABASE_USER=tradeties
DATABASE_PASSWORD=

# --- WorkOS AuthKit ---------------------------------------------------------
# Scopes the JWKS URL the backend validates access tokens against. Without it
# every request fails authentication. Not a secret, but environment-specific.
WORKOS_CLIENT_ID=
