# Copy to .env and fill in. Never commit .env — it is ignored repo-wide.
#
# Docker Compose reads infra/.env automatically. The PostgreSQL variables below
# all have a working default in compose.yaml and are commented out for that
# reason -- uncomment one only on a machine the default does not fit.
# WORKOS_CLIENT_ID has no default.

# --- PostgreSQL -------------------------------------------------------------
# The container from compose.yaml holds two databases: `tradeties` for
# development data and `tradeties_test` for the suite.
#
# Commented out because compose.yaml already defaults to exactly these, which
# are also the defaults in the backend's application.yml -- so
# `./mvnw spring-boot:run` needs no environment of its own. Uncomment only to
# change them, and change DATABASE_* below to match.
#POSTGRES_DB=tradeties
#POSTGRES_USER=tradeties
#POSTGRES_PASSWORD=tradeties

# The HOST port. Set this if you already run PostgreSQL on 5432 -- a native
# install, or another project's container. On Windows that collision does not
# announce itself; infra/README.md has the check and the way out.
#
# Anything other than 5432 also needs DATABASE_URL below, since application.yml
# defaults to 5432.
#POSTGRES_PORT=5432

# --- The backend's connection ------------------------------------------------
# Only needed when the defaults in application.yml do not reach your container:
# a non-default POSTGRES_PORT above, or the backend running inside Compose
# itself, where the host is the service name `postgres` and the port is 5432
# again because it is no longer published but reached over the Compose network.
#
# These are read by the backend, not by Compose, so exporting them in your shell
# does the same thing -- infra/.env only reaches a containerised backend.
#DATABASE_URL=jdbc:postgresql://localhost:55432/tradeties
#DATABASE_USER=tradeties
#DATABASE_PASSWORD=

# --- WorkOS AuthKit ---------------------------------------------------------
# Scopes the JWKS URL the backend validates access tokens against. Without it
# every request fails authentication. Not a secret, but environment-specific.
WORKOS_CLIENT_ID=
